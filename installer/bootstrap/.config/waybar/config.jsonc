{
  "layer": "top", "position": "top", "height": 30,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["network", "pulseaudio", "tray"],
  "hyprland/workspaces": {"format": "{name}", "on-click": "activate"},
  "clock": {"format": "{:%A, %d %B  %H:%M}"},
  "network": {"format-wifi": "WIFI {essid}", "format-ethernet": "LAN", "format-disconnected": "OFFLINE"},
  "pulseaudio": {"format": "VOL {volume}%", "format-muted": "MUTED"}
}
